{%- style -%}
  /* Force Section Outer View wrapper to stretch absolute full width edge-to-edge */
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.section_bg_color }};
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
  }

  /* Full Width & Height Structural Viewport Wrapper */
  .swiper-container-{{ section.id }} {
    width: 100% !important;
    max-width: 100% !important;
    height: {{ section.settings.slider_height_desktop }}vh;
    min-height: 500px;
    position: relative;
    overflow: hidden;
    margin: 0 !important;
  }

  .slide-container-{{ section.id }} {
    display: flex;
    width: 100%;
    height: 100%;
    padding: 0 10%;
    align-items: center;
    justify-content: flex-start;
    background-size: cover;
    background-position: {{ section.settings.bg_position }};
    background-repeat: no-repeat;
    position: relative;
  }

  /* Core Transparent overlay layer to maximize readability over noisy image backgrounds */
  .slide-container-{{ section.id }}::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }});
    z-index: 1;
  }

  .slide-content-{{ section.id }} {
    width: 100%;
    max-width: 650px;
    z-index: 2;
    text-align: left;
  }

  /* Font Configuration Parameters mapped directly with Shopify Engine scale settings */
  .slide-title-{{ section.id }} {
    font-size: {{ section.settings.title_size }}rem;
    font-weight: 700;
    color: {{ section.settings.title_color }};
    line-height: 1.15;
    margin-bottom: 20px;
  }

  .slide-title-{{ section.id }} span {
    display: block;
    color: {{ section.settings.title_span_color }};
  }

  .slide-subtitle-{{ section.id }} {
    font-size: {{ section.settings.subtitle_size }}rem;
    color: {{ section.settings.subtitle_color }};
    margin-bottom: 40px;
  }

  /* Form Container Pills */
  .subscribe-form-{{ section.id }} {
    display: flex;
    align-items: center;
    background-color: {{ section.settings.form_bg_color }};
    padding: 6px 6px 6px 25px;
    border-radius: 50px;
    width: 100%;
    max-width: 450px;
    border: 1px solid rgba(0,0,0,0.05);
  }

  .subscribe-form-{{ section.id }} input {
    border: none;
    outline: none;
    width: 100%;
    font-size: 1rem;
    background: transparent;
    color: {{ section.settings.form_text_color }};
  }

  .subscribe-form-{{ section.id }} button {
    background-color: {{ section.settings.btn_bg_color }};
    color: {{ section.settings.btn_text_color }};
    border: none;
    padding: 15px 32px;
    border-radius: 50px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    white-space: nowrap;
  }

  .subscribe-form-{{ section.id }} button:hover {
    background-color: {{ section.settings.btn_hover_bg_color }};
  }

  /* Fixed Circular Base Vectors for Navigations */
  .swiper-button-next-{{ section.id }},
  .swiper-button-prev-{{ section.id }} {
    background-color: {{ section.settings.nav_bg_color }} !important;
    width: 50px !important;
    height: 50px !important;
    border-radius: 50% !important;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1) !important;
    transition: all 0.3s ease !important;
    position: absolute !important;
    top: 50% !important;
    transform: translateY(-50%) !important;
    z-index: 10 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
  }

  .swiper-button-next-{{ section.id }}::after,
  .swiper-button-prev-{{ section.id }}::after {
    font-size: 16px !important;
    color: {{ section.settings.nav_icon_color }} !important;
    font-weight: bold !important;
    line-height: 1 !important;
    display: block !important;
  }

  .swiper-button-next-{{ section.id }}:hover,
  .swiper-button-prev-{{ section.id }}:hover {
    background-color: {{ section.settings.btn_bg_color }} !important;
  }
  .swiper-button-next-{{ section.id }}:hover::after,
  .swiper-button-prev-{{ section.id }}:hover::after {
    color: {{ section.settings.btn_text_color }} !important;
  }

  .swiper-pagination-{{ section.id }} .swiper-pagination-bullet {
    background: transparent;
    border: 1px solid {{ section.settings.btn_bg_color }};
    opacity: 0.7;
    width: 10px;
    height: 10px;
  }

  .swiper-pagination-{{ section.id }} .swiper-pagination-bullet-active {
    background: {{ section.settings.btn_bg_color }};
    opacity: 1;
    width: 12px;
    height: 12px;
  }

  /* Cross-Device Optimization Viewports */
  @media (max-width: 768px) {
    .swiper-container-{{ section.id }} { 
      height: {{ section.settings.slider_height_mobile }}vh; 
    }
    .slide-container-{{ section.id }} { 
      padding: 0 6%;
      justify-content: center;
      background-position: center center;
    }
    .slide-content-{{ section.id }} { 
      text-align: center; 
    }
    .slide-title-{{ section.id }} { font-size: 2.2rem; }
    .slide-subtitle-{{ section.id }} { font-size: 1.1rem; margin-bottom: 30px; }
    .subscribe-form-{{ section.id }} { margin: 0 auto; padding-left: 15px; }
    .swiper-button-next-{{ section.id }}, .swiper-button-prev-{{ section.id }} { display: none !important; }
  }
{%- endstyle -%}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

<div class="swiper mySwiper-{{ section.id }} swiper-container-{{ section.id }}">
  <div class="swiper-wrapper">
    
    {%- for block in section.blocks -%}
      <div class="swiper-slide" {{ block.shopify_attributes }}>
        
        {%- if block.settings.bg_image != blank -%}
          <div class="slide-container-{{ section.id }}" style="background-image: url('{{ block.settings.bg_image | img_url: '1920x' }}');">
        {%- else -%}
          <div class="slide-container-{{ section.id }}" style="background-color: {{ section.settings.slider_bg_color }};">
        {%- endif -%}
          
          <div class="slide-content-{{ section.id }}">
            {%- if block.settings.heading != blank -%}
              <h1 class="slide-title-{{ section.id }}">
                {{ block.settings.heading }}
                {%- if block.settings.heading_highlight != blank -%}
                  <span>{{ block.settings.heading_highlight }}</span>
                {%- endif -%}
              </h1>
            {%- endif -%}
            
            {%- if block.settings.subheading != blank -%}
              <p class="slide-subtitle-{{ section.id }}">{{ block.settings.subheading }}</p>
            {%- endif -%}
            
            {%- if block.settings.show_newsletter -%}
              {%- form 'customer', class: 'subscribe-form-' | append: section.id -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <input type="email" name="contact[email]" placeholder="{{ block.settings.input_placeholder }}" required>
                <button type="submit">{{ block.settings.button_text }}</button>
              {%- endform -%}
            {%- endif -%}
          </div>

        </div>
      </div>
    {%- endfor -%}

  </div>

  {%- if section.settings.show_arrows -%}
    <div class="swiper-button-prev swiper-button-prev-{{ section.id }}"></div>
    <div class="swiper-button-next swiper-button-next-{{ section.id }}"></div>
  {%- endif -%}

  {%- if section.settings.show_pagination -%}
    <div class="swiper-pagination swiper-pagination-{{ section.id }}"></div>
  {%- endif -%}
</div>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    // FIXED: Strict Parsing mathematical parsing logic to absolute string type mutation prevention
    const autoplayDelayValue = Number("{{ section.settings.autoplay_speed }}") * 1000;

    const swiperInstantiation_{{ section.id | replace: '-', '_' }} = new Swiper(".mySwiper-{{ section.id }}", {
      loop: {{ section.settings.loop }},
      effect: "{{ section.settings.slide_effect }}",
      autoplay: {
        delay: autoplayDelayValue,
        disableOnInteraction: false,
      },
      navigation: {
        nextEl: ".swiper-button-next-{{ section.id }}",
        prevEl: ".swiper-button-prev-{{ section.id }}",
      },
      pagination: {
        el: ".swiper-pagination-{{ section.id }}",
        clickable: true,
      },
    });
  });
</script>

{% schema %}
