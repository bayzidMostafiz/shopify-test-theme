{%- style -%}
  /* --- Structural Heights Matrix --- */
  .hero-slider-{{ section.id }} {
    width: 100%;
    height: {{ section.settings.slider_height_mobile }}px;
    overflow: hidden;
    position: relative;
  }

  @media screen and (min-width: 768px) {
    .hero-slider-{{ section.id }} {
      height: {{ section.settings.slider_height_tablet }}px;
    }
  }

  @media screen and (min-width: 1025px) {
    .hero-slider-{{ section.id }} {
      height: {{ section.settings.slider_height_desktop }}px;
    }
  }

  /* --- Individual Slide Canvas --- */
  .hero-slider-{{ section.id }} .presentation-slide {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    height: 100%;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .hero-slider-{{ section.id }} .slide-content {
    text-align: center;
    z-index: 2;
    width: 100%;
    max-width: 650px;
    margin: 0 auto;
    padding-left: 20px;
    padding-right: 20px;
  }

  /* --- Typography Base (Theme Family Inheritance with Configurable Sizes) --- */
  .hero-slider-{{ section.id }} .slider-rich-heading h1 {
    font-family: var(--font-heading-family), sans-serif;
    color: {{ section.settings.heading_color }};
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 15px;
    font-size: {{ section.settings.heading_size_mobile }}rem;
  }

  .hero-slider-{{ section.id }} .slider-rich-heading h1 span {
    color: {{ section.settings.span_color }};
  }

  .hero-slider-{{ section.id }} p.slide-subheading {
    font-family: var(--font-body-family), sans-serif;
    color: {{ section.settings.text_color }};
    margin-bottom: 35px;
    font-size: {{ section.settings.text_size_mobile }}rem;
  }

  @media screen and (min-width: 768px) {
    .hero-slider-{{ section.id }} .slider-rich-heading h1 { font-size: {{ section.settings.heading_size_tablet }}rem; }
    .hero-slider-{{ section.id }} p.slide-subheading { font-size: {{ section.settings.text_size_tablet }}rem; }
  }

  @media screen and (min-width: 1025px) {
    .hero-slider-{{ section.id }} .slider-rich-heading h1 { font-size: {{ section.settings.heading_size_desktop }}rem; }
    .hero-slider-{{ section.id }} p.slide-subheading { font-size: {{ section.settings.text_size_desktop }}rem; margin-bottom: 35px; }
  }

  /* --- Newsletter Form Specifics --- */
  .hero-slider-{{ section.id }} .newsletter-form {
    display: flex;
    background: #ffffff;
    padding: 6px 6px 6px 25px;
    border-radius: 50px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
    align-items: center;
    width: 100%;
    max-width: 450px;
    margin: 0 auto;
  }
  
  .hero-slider-{{ section.id }} .newsletter-form__fields {
    display: flex;
    width: 100%;
  }

  .hero-slider-{{ section.id }} .newsletter-form input[type="email"] {
    border: none;
    outline: none;
    font-size: 0.95rem;
    color: #253d4e;
    width: 100%;
    background: transparent;
    font-family: var(--font-body-family), sans-serif;
  }

  .hero-slider-{{ section.id }} .newsletter-form input[type="email"]::placeholder {
    color: #b1b1b1;
  }

  .hero-slider-{{ section.id }} .newsletter-form button {
    background-color: {{ section.settings.btn_bg_color }};
    color: #ffffff;
    border: none;
    padding: 15px 35px;
    font-size: 0.95rem;
    font-weight: 500;
    border-radius: 50px;
    cursor: pointer;
    font-family: var(--font-body-family), sans-serif;
    transition: background 0.3s ease;
  }

  .hero-slider-{{ section.id }} .newsletter-form button:hover {
    background-color: {{ section.settings.btn_bg_hover_color }};
  }

  @media (max-width: 768px) {
    .hero-slider-{{ section.id }} .newsletter-form {
      max-width: 100%;
      padding: 5px 5px 5px 15px;
    }
    .hero-slider-{{ section.id }} .newsletter-form button {
      padding: 12px 22px;
      font-size: 0.85rem;
    }
    .hero-slider-{{ section.id }} p.slide-subheading {
      margin-bottom: 25px;
    }
  }

  .hero-slider-{{ section.id }} .newsletter-form .form-success {
    color: {{ section.settings.btn_bg_color }};
    text-align: center;
    width: 100%;
  }

  .hero-slider-{{ section.id }} .newsletter-form .form-errors {
    color: red;
  }

  /* --- Newsletter Modal Styles --- */
  .newsletter-modal {
    display: none; /* Hidden by default */
    position: fixed;
    z-index: 1000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: auto;
    background-color: rgba(0,0,0,0.4);
    align-items: center;
    justify-content: center;
  }

  .newsletter-modal-content {
    background-color: #fefefe;
    margin: auto;
    padding: 20px 30px;
    border: 1px solid #888;
    width: 90%;
    max-width: 400px;
    border-radius: 10px;
    text-align: center;
    position: relative;
  }

  .newsletter-modal-close {
    color: #aaa;
    position: absolute;
    top: 10px;
    right: 15px;
    font-size: 28px;
    font-weight: bold;
    cursor: pointer;
  }

  .newsletter-modal-close:hover {
    color: black;
  }

  /* --- Custom Swiper Pagination Design --- */
  .hero-slider-{{ section.id }} .swiper-pagination {
    bottom: 30px !important;
    z-index: 3;
  }

  .hero-slider-{{ section.id }} .swiper-pagination-bullet {
    width: 11px;
    height: 11px;
    background: transparent;
    border: 1px solid {{ section.settings.heading_color }};
    opacity: 1;
    margin: 0 6px !important;
    transition: all 0.3s ease;
  }

  .hero-slider-{{ section.id }} .swiper-pagination-bullet-active {
    background: {{ section.settings.btn_bg_color }};
    border-color: {{ section.settings.btn_bg_color }};
    transform: scale(1.2);
  }
{%- endstyle -%}

{%- liquid
  assign container_class = 'page-width-container'
  if section.settings.full_width
    assign container_class = 'section-full-bleed'
  endif
-%}

<div class="{{ container_class }}">
  <div class="swiper hero-slider hero-slider-{{ section.id }}" id="Swiper-{{ section.id }}">
    <div class="swiper-wrapper">
      
      {%- for block in section.blocks -%}
        {%- if block.type == 'slide' -%}
          <div class="swiper-slide presentation-slide" 
               style="{% if block.settings.image != blank %}background-image: url('{{ block.settings.image | image_url: width: 1800 }}');{% else %}background-image: url('https://cdn.shopify.com/s/files/1/0533/2089/files/placeholder-images-image_large.png?v=1530129081');{% endif %}"
               {{ block.shopify_attributes }}>
            
            <div class="slide-content" style="text-align: {{ block.settings.content_alignment }};">
              {%- if block.settings.heading != blank -%}
                <div class="slider-rich-heading">
                  {{ block.settings.heading }}
                </div>
              {%- endif -%}
              
              {%- if block.settings.subheading != blank -%}
                <p class="slide-subheading">{{ block.settings.subheading }}</p>
              {%- endif -%}
              
              {%- if block.settings.show_newsletter -%}
                {%- form 'customer', class: 'newsletter-form' -%}
                  <input type="hidden" name="contact[tags]" value="newsletter">
                  <div class="newsletter-form__fields">
                    <input type="email" name="contact[email]" placeholder="Your email address" aria-required="true" autocapitalize="off" autocomplete="email" required>
                    <button type="submit" name="commit">Subscribe</button>
                  </div>
                {%- endform -%}
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}

    </div>

    {%- if section.settings.show_pagination -%}
      <div class="swiper-pagination"></div>
    {%- endif -%}
  </div>

  <div id="newsletter-modal-{{ section.id }}" class="newsletter-modal">
    <div class="newsletter-modal-content">
      <span class="newsletter-modal-close">&times;</span>
      <p id="newsletter-modal-message-{{ section.id }}"></p>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Shopify Customizer event listener handler trigger structure configuration runtime map parameters
    const initSwiper = () => {
      const sliderEl = document.querySelector('#Swiper-{{ section.id }}');
      if (!sliderEl) return;
      
      const delayTime = parseInt('{{ section.settings.autoplay_delay }}') * 1000;
      const isLoop = {{ section.settings.loop | json }};

      new Swiper('#Swiper-{{ section.id }}', {
        loop: isLoop,
        watchSlidesProgress: true,
        preloadImages: false,
        lazy: true,
        autoplay: {
          delay: delayTime,
          disableOnInteraction: false,
          pauseOnMouseEnter: true
        },
        pagination: {
          el: '#Swiper-{{ section.id }} .swiper-pagination',
          clickable: true,
        },
      });
    };

    // First time regular initialization standard response execution
    initSwiper();

    // Shopify customizer design environment block refresh reload engine pipeline parameters updates trackers
    document.addEventListener('shopify:section:load', function(event) {
      if (event.detail.sectionId === '{{ section.id }}') {
        initSwiper();
      }
    });

    // --- AJAX Newsletter & Modal ---
    const newsletterForm = document.querySelector('#shopify-section-{{ section.id }} .newsletter-form');
    const modal = document.getElementById('newsletter-modal-{{ section.id }}');
    const modalMessage = document.getElementById('newsletter-modal-message-{{ section.id }}');
    const closeModal = document.querySelector('#newsletter-modal-{{ section.id }} .newsletter-modal-close');

    if (newsletterForm) {
      newsletterForm.addEventListener('submit', function(event) {
      event.preventDefault();
      
      const form = event.target;
      const emailInput = form.querySelector('input[type="email"]');
      const submitButton = form.querySelector('button[type="submit"]');
      const originalButtonText = submitButton.textContent;

      submitButton.textContent = 'Submitting...';
      submitButton.disabled = true;

      const formData = new FormData(form);

      fetch(form.action, {
        method: 'POST',
        body: formData,
        headers: {
          'X-Requested-With': 'XMLHttpRequest'
        }
      })
      .finally(() => {
        // Even if the user is already subscribed (non-200 response), we show success.
        modalMessage.textContent = 'Thanks for subscribing!';
        modal.style.display = 'flex';
        
        // Reset form state
        submitButton.textContent = originalButtonText;
        submitButton.disabled = false;
        emailInput.value = '';
      });
    });
    }

    if(closeModal) {
      closeModal.onclick = function() {
        modal.style.display = "none";
      }
    }

    window.onclick = function(event) {
      if (event.target == modal) {
        modal.style.display = "none";
      }
    }
  });
</script>

{% schema %}
{
  "name": "Hero Slider Banner",
  "settings": [
    {
      "type": "header",
      "content": "Slider Performance"
    },
    {
      "type": "checkbox",
      "id": "loop",
