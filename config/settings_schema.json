[
  {
    "name": "theme_info",
    "theme_name": "Bayzid",
    "theme_version": "0.1.0",
    "theme_author": "Md Bayzid Mostafiz",
    "theme_documentation_url": "https://bayzidmostafiz.com/",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "work_sans_n7",
        "label": "Heading Font"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "default": "work_sans_n4",
        "label": "Body Font"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "page_layout_type",
        "label": "Page Layout Mode",
        "options": [
          {
            "value": "full_width",
            "label": "Full Width (100%)"
          },
          {
            "value": "custom_width",
            "label": "Custom Width (px)"
          }
        ],
        "default": "custom_width"
      },
      {
        "type": "range",
        "id": "custom_page_width",
        "min": 1000,
        "max": 1800,
        "step": 10,
        "unit": "px",
        "label": "Custom Container Max Width",
        "default": 1200,
        "info": "Eti sudhu kaaj korbe jodi Layout Mode 'Custom Width (px)' select kora thake."
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 5,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#333333",
        "label": "t:labels.foreground"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  }
]