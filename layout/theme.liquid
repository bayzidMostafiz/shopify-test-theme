<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% comment %}
      Font preloading:
      1. Preconnect to font CDN for faster connection
      2. Preload only the critical font variant (base weight)
      3. Additional variants load on-demand via @font-face
    {% endcomment %}
    {%- liquid
  assign heading_font = settings.type_heading_font
  assign body_font = settings.type_body_font
-%}

{%- if heading_font or body_font -%}
  <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

  {%- comment -%} Preload Body Font (jodi custom/Google font hoy ebong system font na hoy) {%- endcomment -%}
  {%- if body_font and body_font.system? == false -%}
    {{ body_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  {%- endif -%}

  {%- comment -%} Preload Heading Font (jodi custom/Google font hoy ebong system font na hoy) {%- endcomment -%}
  {%- if heading_font and heading_font.system? == false -%}
    {{ heading_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  {%- endif -%}
{%- endif -%}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}


    {{ 'base.css' | asset_url | stylesheet_tag }}


    {% comment %} Swiper Slider Integration {% endcomment %}
    <link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
/>



    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    {% comment %} Swiper Slider Integration Js {% endcomment %}
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    {{ content_for_header }}

    {%- liquid
    assign heading_font = settings.type_heading_font
    assign body_font = settings.type_body_font
    
    # Base configuration weights separation bold styles modifier parameters optimization context
    assign heading_font_bold = heading_font | font_modify: 'weight', 'bold'
    assign body_font_bold = body_font | font_modify: 'weight', 'bold'
    assign body_font_italic = body_font | font_modify: 'style', 'italic'
  -%}

  <style>
    {{ heading_font | font_face: font_display: 'swap' }}
    {{ body_font | font_face: font_display: 'swap' }}

    {% if heading_font_bold %}
      {{ heading_font_bold | font_face: font_display: 'swap' }}
    {% endif %}

    {% if body_font_bold %}
      {{ body_font_bold | font_face: font_display: 'swap' }}
    {% endif %}

    {% if body_font_italic %}
      {{ body_font_italic | font_face: font_display: 'swap' }}
    {% endif %}

    :root {
      /* Heading Typography Rules configuration logic variables maps layout processing templates */
      --font-heading-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
      --font-heading-style: {{ heading_font.style }};
      --font-heading-weight: {{ heading_font.weight }};

      /* Body Typography Context maps system rule setup variables logic */
      --font-body-family: {{ body_font.family }}, {{ body_font.fallback_families }};
      --font-body-style: {{ body_font.style }};
      --font-body-weight: {{ body_font.weight }};
      
      /* Global existing application schema structure config values */      
      --color-bg: {{ settings.background_color }};
      --color-foreground: {{ settings.foreground_color }};
      --input-radius: {{ settings.input_corner_radius }}px;

      {%- if settings.page_layout_type == 'full_width' -%}
        --page-max-width: 100%;
      {%- else -%}
        --page-max-width: {{ settings.custom_page_width }}px;
      {%- endif -%}

      --page-min-margin: {{ settings.min_page_margin }}px;
    }
  </style>


  </head>

  <body>
    {% sections 'header-group' %}
    

    {{ content_for_layout }}

    {% sections 'footer-group' %}
  </body>
</html>
